# FastAPI 应用名称。
APP_NAME=FastAPI Custom Template

# 是否启用 FastAPI 调试模式。
APP_DEBUG=false

# 允许跨域访问的来源、方法和请求头，值必须是 JSON 数组。
APP_CORS_ALLOW_ORIGINS=["http://localhost:3000"]
APP_CORS_ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
APP_CORS_ALLOW_HEADERS=["Accept","Authorization","Content-Type"]

# MySQL 服务地址、端口、连接超时和数据库名称。
APP_DATABASE_HOST=127.0.0.1
APP_DATABASE_PORT=3306
APP_DATABASE_CONNECT_TIMEOUT_SECONDS=5
APP_DATABASE_NAME=app

# MySQL 登录凭据，部署时必须填写。
APP_DATABASE_USER=
APP_DATABASE_PASSWORD=
